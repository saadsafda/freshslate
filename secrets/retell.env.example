# Copy this to retell.env and fill in real values directly on the server —
# never in chat, never committed to git.
# Twilio is not used - calling is Retell-native only (see call-script.md).
RETELL_API_KEY=
# NOT a separate secret - Retell has no such thing. This must be one of your
# Retell API keys (Dashboard > Settings > API Keys) that has the "webhook"
# badge next to it. Retell signs X-Retell-Signature with
# HMAC-SHA256(raw_body + timestamp, THIS_key). See
# https://docs.retellai.com/features/secure-webhook. If it's not the
# webhook-badged key, every real Retell webhook call will 401 here even
# though self-signed synthetic tests still pass (they just sign+verify with
# the same wrong value on both sides).
RETELL_WEBHOOK_SECRET=
RETELL_AGENT_ID=
# Must be a number actually purchased/imported in the Retell account -
# Retell's create-phone-call API requires this and will not auto-select one.
# Provisioning failed on 2026-08-10 with "requires a card on file" - add a
# payment method in the Retell dashboard, then provision (dashboard or
# create-phone-number API) and paste the resulting E.164 number here.
RETELL_FROM_NUMBER=
