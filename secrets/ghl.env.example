# Copy this to ghl.env and fill in real values directly on the server via
# your own SSH session — never in chat, never committed to git.
#
# GHL_API_KEY: a GoHighLevel Private Integration token (Settings > Private
# Integrations in the sub-account), not the legacy per-location API key —
# those are deprecated. Scope it to Contacts read/write only.
# GHL_LOCATION_ID: the sub-account (location) ID the contacts belong to.
GHL_API_KEY=
GHL_LOCATION_ID=
