# Secrets — never commit
.env
*.env
secrets/
!secrets/*.env.example
*.key
*.pem
credentials/
**/openclaw.json

# Sweep output contains personal information about individuals in financial
# distress. Keep it local; do not commit to a shared repo.
deals/_inbox/*.md
deals/_inbox/*.json
deals/_active/
deals/_index/seen.json

__pycache__/
*.pyc
.venv/
venv/
.DS_Store

# Call logs contain phone numbers, transcripts, and opt-out records.
# Suppression list is a do-not-call register. Both are PII — keep local.
deals/_index/calls/
deals/_config/suppression-list.txt
